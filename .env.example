# Required: local | staging | production. Deployments must set it as a real env var; .env is
# only read when it isn't staging or production (see src/membership_management/env_file.py).
ENVIRONMENT=local
DEBUG=True

# Optional. Comma-separated browser origins allowed to call this API cross-origin. Empty means the
# CORS middleware isn't mounted, which is correct locally and in production: staff-app calls this
# API server-side (no browser involved) and /docs is same-origin.
CORS_ALLOWED_ORIGINS=

# Bare origin of auth-server as this API reaches it (no trailing slash, no /api/auth suffix) --
# used only to build the JWKS URL. In AWS this is the internal Service Connect address
# (e.g. http://auth-server:5000), not the public URL.
AUTH_SERVER_URL=http://localhost:5000

# Expected iss/aud claims on every JWT this API verifies. Must equal auth-server's BETTER_AUTH_URL
# origin exactly (no trailing slash): the PUBLIC url, e.g. https://staff.example.org in prod. Locally
# that's the same as AUTH_SERVER_URL, but in AWS the two differ.
JWT_ISSUER=http://localhost:5000
JWT_AUDIENCE=http://localhost:5000

# --- Databases ---
# Each DB reads its own prefixed settings (ASSIMILATION_* / MEMBERS_*) so they're tuned
# independently. The DB_* settings below are optional; the values shown are the defaults.
#   DB_CONNECT_TIMEOUT_SECONDS  time to establish a new connection before giving up
#   DB_QUERY_TIMEOUT_SECONDS    time a single query may run before the DB aborts it
#   DB_POOL_TIMEOUT_SECONDS     time a request waits for a free pooled connection
#   DB_POOL_RECYCLE_SECONDS     max age of a pooled connection before it's reconnected
#   DB_POOL_SIZE                connections kept open per process, even when idle
#   DB_MAX_OVERFLOW             extra connections allowed under burst load, closed afterwards
#   DB_POOL_PRE_PING            ping a pooled connection before handing it out, replacing it if
#                               the server silently closed it
#   DB_POOL_USE_LIFO            reuse the most-recently-returned connection first, so a small
#                               working set stays warm under light/bursty load
#
# Pool sizing: a single process holds up to DB_POOL_SIZE + DB_MAX_OVERFLOW connections per DB.
# With multiple containers or WORKERS (see below) the real ceiling per DB is:
#   (WORKERS x replica count) x (DB_POOL_SIZE + DB_MAX_OVERFLOW)

# SQL Server (the existing "assimilation" system). All credentials live inside the URL. This DB is
# shared with the existing church web app, so the ceiling above has to stay comfortably under the
# headroom SQL Server actually has left, not just under its hard connection limit.
ASSIMILATION_DATABASE_URL=mssql+pyodbc://sa:YourStrongPassword123@localhost:1433/mydb?driver=ODBC+Driver+18+for+SQL+Server
ASSIMILATION_DB_CONNECT_TIMEOUT_SECONDS=5
ASSIMILATION_DB_QUERY_TIMEOUT_SECONDS=30
ASSIMILATION_DB_POOL_TIMEOUT_SECONDS=30
ASSIMILATION_DB_POOL_RECYCLE_SECONDS=1800
ASSIMILATION_DB_POOL_SIZE=5
ASSIMILATION_DB_MAX_OVERFLOW=5
ASSIMILATION_DB_POOL_PRE_PING=True
ASSIMILATION_DB_POOL_USE_LIFO=True

# PostgreSQL (this service's own members DB). Use 127.0.0.1, not localhost: on Windows localhost
# resolves to ::1 first, which never answers against Docker Desktop's Postgres. On RDS, the
# instance's max_connections (set by its memory size) is shared by everything connecting to it:
#   (WORKERS x replicas) x (MEMBERS_DB_POOL_SIZE + MEMBERS_DB_MAX_OVERFLOW)
#   + auth-server's pool + 1 for the migration task + a few for admin tools (pgAdmin, psql)
MEMBERS_DATABASE_URL=postgresql+psycopg://postgres:theUltraSecretPassword@127.0.0.1:5432/ekklesiaio-members-management
MEMBERS_DB_CONNECT_TIMEOUT_SECONDS=5
# Enforced server-side as Postgres' statement_timeout
MEMBERS_DB_QUERY_TIMEOUT_SECONDS=30
MEMBERS_DB_POOL_TIMEOUT_SECONDS=30
MEMBERS_DB_POOL_RECYCLE_SECONDS=1800
MEMBERS_DB_POOL_SIZE=5
MEMBERS_DB_MAX_OVERFLOW=5
MEMBERS_DB_POOL_PRE_PING=True
MEMBERS_DB_POOL_USE_LIFO=True
# Postgres ends a session left idle inside an open transaction this long, releasing its locks
MEMBERS_DB_IDLE_IN_TRANSACTION_TIMEOUT_SECONDS=60
# Migrations only: how long DDL waits for a table lock before failing (instead of stalling every
# query queued behind it). Migrations have no statement timeout, so long backfills still work.
MEMBERS_MIGRATION_LOCK_TIMEOUT_SECONDS=5

# Port the production server (run.py) binds to
PORT=8000

# Uvicorn worker processes for run.py. Each worker is a separate process with
# its own DB connection pool (see the pool-sizing note above) and its own
# in-memory rate-limiter counters, so a "10/minute" limit becomes effectively
# "10 x WORKERS per minute". Once deployed behind an orchestrator (ECS/K8s),
# prefer scaling via replica count and leave this at 1.
WORKERS=1

# Wall-clock cap (seconds) on handling a single API request
REQUEST_TIMEOUT_SECONDS=30
# How long (seconds) an idle keep-alive connection stays open
KEEP_ALIVE_TIMEOUT_SECONDS=5
# How long (seconds) in-flight requests get to finish on shutdown (e.g. SIGTERM)
GRACEFUL_SHUTDOWN_TIMEOUT_SECONDS=30

# Default rate limit per authenticated user (verified JWT sub), across all
# routes (`limits` syntax, e.g. "60/minute"). With the in-memory store below it
# is not shared across WORKERS or replicas -- see the warning in rate_limit.py.
DEFAULT_RATE_LIMIT=60/minute

# Where rate-limit counters are stored (a `limits` storage URI). memory:// is per-process; use a
# shared store such as redis://<host>:6379 (needs the `limits[redis]` extra) once WORKERS or
# replicas go above 1, otherwise the limit above multiplies by (workers x replicas).
RATE_LIMIT_STORAGE_URI=memory://

# Max simultaneous connections uvicorn accepts before returning 503 to new
# ones. Leave commented out for unlimited (uvicorn's own default) -- an
# empty value here will fail to parse as an int.
# LIMIT_CONCURRENCY=100
# Max pending TCP connections queued once capacity is saturated, before
# refusing new ones outright. 2048 matches uvicorn's own default.
BACKLOG=2048

# Max sync ("def", not "async def") route handlers/dependencies allowed to
# run concurrently per process -- these run on a thread pool, not the
# asyncio event loop ("async def" routes bypass this entirely). 40 matches
# anyio's own default. Per process, same caveat as the *_DB_POOL_SIZE/
# *_DB_MAX_OVERFLOW settings above: multiply by (workers x replicas) for the
# real total. If this is smaller than a DB's POOL_SIZE + MAX_OVERFLOW, this
# becomes the binding concurrency limit for sync routes using that DB
# instead of its pool. Unlike LIMIT_CONCURRENCY/BACKLOG/WORKERS, this one is
# applied inside the app itself (not passed to uvicorn), so it takes
# effect under `fastapi dev` too, not just run.py.
THREAD_POOL_SIZE=40