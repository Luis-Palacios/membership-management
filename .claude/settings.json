{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"import(require('node:url').pathToFileURL(require('node:path').resolve(process.env.CLAUDE_PROJECT_DIR || '.', '.claude/hooks/branch-name.mjs')))\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project --quiet python -c \"import os,runpy; runpy.run_path(os.path.join(os.environ.get('CLAUDE_PROJECT_DIR') or '.', '.claude/hooks/check.py'),run_name='__main__')\"",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project --quiet python -c \"import os,runpy; runpy.run_path(os.path.join(os.environ.get('CLAUDE_PROJECT_DIR') or '.', '.claude/hooks/check.py'),run_name='__main__')\"",
            "timeout": 180
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"process.argv.splice(1,0,'hook'); import(require('node:url').pathToFileURL(require('node:path').resolve(process.env.CLAUDE_PROJECT_DIR || '.', '.claude/hooks/check-tools.mjs')))\" pyright-langserver",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "pyright-lsp@claude-plugins-official": true
  }
}
